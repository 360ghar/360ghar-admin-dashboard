VITE_API_BASE_URL=http://localhost:3600/api/v1
# Dev-only: origin the Vite dev server proxies API requests to (browser only
# talks to localhost, so no CORS and no dependency on the dev port). Unset →
# https://api.360ghar.com. Point this at your local backend when developing
# against one (e.g. DEV_API_PROXY_TARGET=http://localhost:3600).
# DEV_API_PROXY_TARGET=https://api.360ghar.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated email-domain allowlist for Google sign-in into the portal.
# When unset, defaults to 360ghar.com (the staff domain).
# VITE_ALLOWED_GOOGLE_EMAIL_DOMAINS=360ghar.com
# Google sign-in uses the Supabase OAuth redirect flow, so NO client-side
# Google client ID is required here. (VITE_GOOGLE_OAUTH_CLIENT_ID would only be
# needed for a future One-Tap / signInWithIdToken enhancement.)
