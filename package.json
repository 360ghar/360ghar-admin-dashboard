		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/leaflet": "^1.9.20",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.180.0",
		"@vitejs/plugin-react": "^4.3.1",
