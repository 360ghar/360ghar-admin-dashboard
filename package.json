		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.17",
		"gsap": "^3.15.0",
		"leaflet": "^1.9.4",
		"lucide-react": "^1.60.0",
		"motion": "^14.5.0",
		"next-themes": "^0.4.6",
		"ogl": "^1.0.11",
		"react": "^19.3.1",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.90.0",
