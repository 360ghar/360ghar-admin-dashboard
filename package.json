{
	"name": "360ghar-admin-portal",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:sync": "cp \"${BACKEND_DIR:-../360ghar-backend}/docs/openapi.json\" openapi/openapi.json",
		"api:types": "openapi-typescript openapi/openapi.json --default-non-nullable false -o src/lib/api/schema.gen.ts",
		"typecheck": "tsc -b --pretty",
		"typecheck:tests": "tsc -p tsconfig.test.json --noEmit --pretty && tsc -p tsconfig.browser.json --noEmit --pretty",
		"lint": "eslint src tests playwright.config.ts --max-warnings=0",
		"lint:fix": "eslint src tests playwright.config.ts --fix",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:watch": "vitest",
		"prepare": "husky install"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
